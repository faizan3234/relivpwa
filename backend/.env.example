# Copy this file to .env for local development (npm run dev).
# On Render, set these under Dashboard > your service > Environment instead -
# real env vars are what stop your VAPID keys (and therefore every phone's
# push subscription) from resetting on every redeploy.
#
# NOTHING in here belongs in app.js or any file the browser downloads.
# Client-side JavaScript in a PWA is fully public.

# Generate a pair once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# AI providers. These previously had fallbacks hardcoded in server.js, which
# published them to anyone who read the repo. Rotate any key that was ever
# committed, then set the new value here.
GEMINI_API_KEY=
GROQ_API_KEY=

# Model IDs are overridable so a provider deprecation is a config change,
# not a redeploy of code. Defaults are set in server.js.
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Razorpay - streak restore payments.
# The SECRET must never leave the server. Only RAZORPAY_KEY_ID is sent to the
# browser (that one is public by design; the secret signs and verifies).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Streak restore pricing, in rupees. Price scales with the length of the streak
# being bought back and is clamped between these two values.
# RESTORE_MIN_RUPEES=5
# RESTORE_MAX_RUPEES=25

PORT=4000
